{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Workshop window may do. Network access is limited to AI on this computer (any local port), Hugging Face and Tavily web search, which people connect themselves in Admin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:11434/*" },
        { "url": "http://localhost:11434/*" },
        { "url": "http://127.0.0.1:7860/*" },
        { "url": "http://localhost:7860/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "https://router.huggingface.co/*" },
        { "url": "https://huggingface.co/api/*" },
        { "url": "https://api.tavily.com/*" }
      ]
    }
  ]
}
